# Flash & Partition Table Configuration (4MB Flash, 80MHz DIO)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHMODE="dio"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# CPU Frequency 240 MHz (Maximum Performance)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Compiler Performance Optimization (-O2)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# FreeRTOS 1000 Hz Tick Rate & Stack Overflow Hardware Watchpoint
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# High-Performance IRAM Placements
CONFIG_UART_ISR_IN_IRAM=y

# SPI Ethernet Driver (W5500 Native Component)
CONFIG_ETH_USE_SPI_ETHERNET=y

# lwIP TCP/IP Stack Tuning (Max Throughput & Multi-Client)
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8640
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_MAX_ACTIVE_TCP=8
CONFIG_LWIP_MAX_LISTENING_TCP=4
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_TCP_KEEP_ALIVE=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Native ESP-IDF HTTP Server & WebSocket Support
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# OTA Bootloader Auto-Rollback Protection
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Brownout threshold ~2.6V (Level 5) untuk proteksi Flash & W5500 saat suplai turun
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_5=y
CONFIG_ESP_BROWNOUT_DET_LVL=5
# mbedTLS Memory Optimization (Static 8 KB RX Content Len)
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_MAX_FRAGMENT_LENGTH=y
