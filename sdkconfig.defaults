# Flash & Partition Table Configuration (4MB Flash)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Compiler Performance Optimization (-O2)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# FreeRTOS 1000 Hz Tick Rate (1ms precision)
CONFIG_FREERTOS_HZ=1000

# SPI Ethernet Driver (W5500 Native Component)
CONFIG_ETH_USE_SPI_ETHERNET=y

# lwIP TCP/IP Stack Tuning
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5840
CONFIG_LWIP_TCP_WND_DEFAULT=5840

# Native ESP-IDF HTTP Server & WebSocket Support
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# OTA Bootloader Auto-Rollback Protection
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
