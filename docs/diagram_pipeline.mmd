%% IOTARU SG-10 - Deep Code-Level Flowchart (Files, Functions, Variables & RTOS Queues)
%% Compatible with mermaid.live and VS Code Markdown Preview

flowchart TD
    classDef fileNode fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef funcNode fill:#1e1b4b,stroke:#818cf8,stroke-width:1.5px,color:#e0e7ff;
    classDef varNode fill:#064e3b,stroke:#10b981,stroke-width:1.5px,color:#a7f3d0;
    classDef queueNode fill:#065f46,stroke:#34d399,stroke-width:2px,color:#ffffff;
    classDef decision fill:#431407,stroke:#f59e0b,stroke-width:2px,color:#fde68a;
    classDef drop fill:#450a0a,stroke:#ef4444,stroke-width:1.5px,color:#fca5a5;

    subgraph SUB1["1. BOOT & HARDWARE INIT (src/main.cpp & src/bsp/*)"]
        M1["src/main.cpp<br/><b>app_main()</b>"]:::fileNode
        M1 --> CFG["src/core/config_store.cpp<br/><b>ConfigStore::loadConfig()</b><br/>Var: <i>Iotaru::g_config</i> (POD)"]:::varNode
        CFG --> BTN["src/bsp/bsp_button.cpp<br/><b>BspButton::checkBootAction()</b><br/>Pin: GPIO 34 (&lt;5s, 5-10s, &gt;10s)"]:::funcNode
        BTN --> LED["src/bsp/bsp_led.cpp<br/><b>s_ledTask()</b><br/>Pin: GPIO 13 (WS2812B Dual LED)"]:::funcNode
        LED --> NET["src/network/net_manager.cpp<br/><b>NetManager::init()</b><br/>Var: <i>g_config.connection_mode</i>"]:::funcNode
    end

    subgraph SUB2["2. INGESTION & FILTER HOT-PATH (CORE 0 - PRO_CPU)"]
        NRF["<b>Co-Processor nRF52840</b><br/>BLE Ch 37, 38, 39<br/>Pack: 25-Byte Binary Frame"]:::fileNode
        NRF -->|UART2 1 Mbps (RX GPIO 16)| U1["src/bsp/bsp_uart.cpp<br/><b>uart_event_task()</b><br/>Var: <i>s_uartQueue</i>, <i>dtmp[1024]</i>"]:::funcNode
        
        U1 --> P1["src/core/beacon_pipeline.cpp<br/><b>BeaconPipeline::processByte(b)</b><br/>Var: <i>s_parserState (SYNC_1, SYNC_2, DATA)</i><br/>Buffer: <i>s_rxFrameBuffer[25]</i>"]:::funcNode
        
        P1 --> CRC["src/utils/crc_utils.hpp<br/><b>CrcUtils::isValidXorChecksum()</b><br/>XOR(bytes 0..23) == byte[24]"]:::funcNode
        CRC --> C_CHK{"CRC XOR<br/>Valid?"}:::decision
        C_CHK -- Tidak --> D_CRC["<b>Drop Frame</b><br/>Var: <i>s_crcErrorCount++</i>"]:::drop
        
        C_CHK -- Valid --> F_RSSI{"Filter 1:<br/>packet.rssi &gt;= <b>g_config.rssi_min</b>?"}:::decision
        F_RSSI -- Tidak --> D_RSSI["<b>Drop Paket</b><br/>Signal Weak (&lt; min)"]:::drop
        
        F_RSSI -- Lolos --> F_UUID{"Filter 2:<br/><b>g_config.filter_uuid_en</b> == 1?"}:::decision
        F_UUID -- Aktif --> F_U_MATCH{"memcmp(uuid,<br/><b>filter_uuid_bytes</b>, 16)?"}:::decision
        F_U_MATCH -- Beda --> D_UUID["<b>Drop Paket</b><br/>UUID Mismatch"]:::drop
        F_U_MATCH -- Cocok --> F_MAJ
        F_UUID -- Nonaktif --> F_MAJ{"Filter 3:<br/><b>g_config.filter_major_en</b> == 1?"}:::decision
        
        F_MAJ -- Aktif --> F_M_MATCH{"matchMajorFilter(<br/>major, <b>filter_major</b>)?"}:::decision
        F_M_MATCH -- Beda --> D_MAJ["<b>Drop Paket</b><br/>Major Mismatch"]:::drop
        F_M_MATCH -- Cocok --> PUSH
        F_MAJ -- Nonaktif --> PUSH
        
        subgraph DISP["Dispatcher Logic"]
            PUSH["<b>BeaconPipeline::pushPacket()</b><br/>Var: <i>s_readCount++</i> (Atomic)"]:::varNode
            PUSH --> Q_CHK{"s_beaconQueue Penuh?<br/>(Limit 300 Item)"}:::decision
            Q_CHK -- Penuh --> Q_DROP["<b>xQueueReceive(oldest)</b><br/>Drop Paket Terlama"]:::drop
            Q_DROP --> Q_SEND
            Q_CHK -- Ada Slot --> Q_SEND["<b>xQueueSend(packet, 0)</b>"]:::funcNode
            Q_SEND --> Q_BUF[("FreeRTOS Queue<br/><b>s_beaconQueue</b><br/>(300 Slot BeaconPacket)")]:::queueNode
            
            PUSH --> LIVE["<b>recordLiveBeacon()</b><br/>Mutex: <i>s_liveBufMutex</i> (5ms)"]:::funcNode
            LIVE --> L_BUF[("Shared Mutex Buffer<br/><b>s_liveBeaconBuf[50]</b><br/>Var: <i>s_liveBeaconCount++</i>")]:::queueNode
        end
    end

    subgraph SUB3["3. MQTT BATCH PUBLISHER (CORE 1 - APP_CPU)"]
        MQ_TASK["src/network/mqtt_service.cpp<br/><b>MqttService::publisherTask()</b>"]:::funcNode
        Q_BUF -->|xQueueReceive| MQ_TASK
        MQ_TASK --> MQ_BUF["<b>appendToBatch(pkt)</b><br/>Buffer: <i>m_batchBuffer[4096]</i><br/>Format: Binary 6B / 7B"]:::varNode
        MQ_BUF --> MQ_COND{"m_batchCount &gt;= <b>batch_max</b><br/>ATAU elapsed &gt;= <b>batch_flush</b>?"}:::decision
        MQ_COND -- Belum --> MQ_TASK
        MQ_COND -- Kirim --> MQ_PUB["<b>MqttService::flushBatch()</b><br/>API: <i>esp_mqtt_client_publish()</i><br/>Topic: <i>beacon/%device_id%</i><br/>Var: <i>m_mqttPublishCount++</i>"]:::funcNode
        MQ_PUB --> MQ_NET["Hitung Egress Throughput<br/>Var: <i>m_netBandwidth</i> (KB/s)"]:::varNode
        MQ_NET --> ETH["src/network/drivers/EthernetW5500.cpp<br/><b>W5500 SPI DMA (25 MHz)</b> / Wi-Fi"]:::fileNode
    end

    subgraph SUB4["4. WEB SERVER & WEBSOCKET (CORE 1 - APP_CPU)"]
        WS_TASK["src/web/web_server.cpp<br/><b>WebServer::wsBroadcastTask()</b><br/>Interval: 100 ms Periodik"]:::funcNode
        WS_TASK --> WS_CHK{"Ada Klien Aktif di /ws?<br/><i>httpd_get_client_list()</i>"}:::decision
        WS_CHK -- Tidak --> WS_TASK
        WS_CHK -- Ada Klien --> WS_DRAIN["src/core/beacon_pipeline.cpp<br/><b>BeaconPipeline::drainLiveBeacons()</b><br/>Ambil data dari <i>s_liveBeaconBuf</i>"]:::funcNode
        L_BUF -.->|Mutex Lock 5ms| WS_DRAIN
        WS_DRAIN --> WS_JSON["Serialisasi JSON Telemetri +<br/>Maks 50 Item Live Beacon Array"]:::varNode
        WS_JSON --> WS_SEND["API: <b>httpd_ws_send_frame_async()</b><br/>Text Frame Non-Blocking"]:::funcNode
        WS_SEND --> WEB_UI["Frontend Browser Client<br/><b>data/test.html</b> &amp; <b>test.js</b><br/>HUD Speed &amp; 60s Canvas Chart"]:::fileNode
    end
